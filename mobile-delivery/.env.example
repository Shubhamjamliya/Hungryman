# mobile-delivery/.env: build-time values only (changing them needs a new APK).
# Addresses are optional in production: they default to https://jharkhandrasoi.com
EXPO_PUBLIC_API_BASE_URL=https://jharkhandrasoi.com/api/v1
EXPO_PUBLIC_SOCKET_BASE_URL=https://jharkhandrasoi.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY
# Release builds with an Android-restricted Maps key: SHA-1 of the release signing key (no colons)
# EXPO_PUBLIC_ANDROID_CERT_SHA1=
# Also needed: google-services.json (push notifications) in this folder
