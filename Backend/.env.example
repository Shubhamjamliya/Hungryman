# Backend/.env: copy to .env and fill in. Only startup settings go here;
# everything else (payments, SMS, email, Firebase, Maps...) loads from the
# database (Admin > Environment & Keys).
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING
# Must be the SAME key the server uses (ask the admin), or saved keys can't be read
ENCRYPTION_KEY=ASK_ADMIN_FOR_THE_SAME_KEY
